    {
      "parameters": {
        "jsCode": "const address = $input.first().json.from.value[0].address.toLowerCase();\n\n// Exact email matches first\nconst exactMap = {\n  'your-email@example.com':   'NOTION_DB_ID_CLIENT_B',\n};\n\n// Domain → Notion DB ID\nconst domainMap = {\n  'client-a.example.com':    'NOTION_DB_ID_CLIENT_A',\n  'client-b.example.com':         'NOTION_DB_ID_CLIENT_B',\n  'client-c.example.com':      'NOTION_DB_ID_CLIENT_C',\n  'client-c2.example.com':          'NOTION_DB_ID_CLIENT_C',\n  'client-d.example.com':          'NOTION_DB_ID_CLIENT_D',\n  'client-e2.example.com':        'NOTION_DB_ID_CLIENT_E',\n  'client-e3.example.com': 'NOTION_DB_ID_CLIENT_E',\n  'client-e.example.com': 'NOTION_DB_ID_CLIENT_E',\n  'client-f.example.com':          'NOTION_DB_ID_CLIENT_F',\n  'client-g2.example.com':          'NOTION_DB_ID_CLIENT_G',\n  'client-g.example.com':            'NOTION_DB_ID_CLIENT_G',\n  'client-h.example.com':         'NOTION_DB_ID_CLIENT_H',\n  'client-i.example.com':         'NOTION_DB_ID_CLIENT_I',\n  'client-j.example.com':          'NOTION_DB_ID_CLIENT_J',\n  'client-j2.example.com':         'NOTION_DB_ID_CLIENT_J',\n  'client-k.example.com':            'NOTION_DB_ID_CLIENT_K',\n  'client-l.example.com':              'NOTION_DB_ID_CLIENT_L',\n  'client-l2.example.com':          'NOTION_DB_ID_CLIENT_L',\n  'client-m.example.com':              'NOTION_DB_ID_CLIENT_M',\n  'client-o.example.com':     'NOTION_DB_ID_CLIENT_O',\n  'client-p.example.com':              'NOTION_DB_ID_CLIENT_P',\n  'client-n.example.com':        'NOTION_DB_ID_CLIENT_N',\n};\n\n// Resolve: exact match first, then domain\nconst domain = address.split('@')[1];\nconst notionDatabaseId = exactMap[address] || domainMap[domain] || null;\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    notionDatabaseId\n  }\n}];"
      },
