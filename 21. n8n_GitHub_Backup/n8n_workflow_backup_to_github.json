    {
      "parameters": {
        "jsCode": "function deepClean(obj) {\n  if (typeof obj !== 'object' || obj === null) return obj;\n  if (Array.isArray(obj)) return obj.map(deepClean);\n  const volatileKeys = ['id','webhookId','credentials','position','createdAt','updatedAt','versionId','versionCounter','triggerCount','staticData','pinData','meta','shared','tags','activeVersionId','activeVersion','isArchived','description','__rl','cachedResultName','cachedResultUrl'];\n  const cleaned = {};\n  for (const [key, value] of Object.entries(obj)) {\n    if (volatileKeys.includes(key)) continue;\n    cleaned[key] = deepClean(value);\n  }\n  return cleaned;\n}\n\nfunction sortObject(obj) {\n  if (typeof obj !== 'object' || obj === null) return obj;\n  if (Array.isArray(obj)) return obj.map(sortObject);\n  const sorted = {};\n  Object.keys(obj).sort().forEach(key => {\n    sorted[key] = sortObject(obj[key]);\n  });\n  return sorted;\n}\n\nfor (const item of $input.all()) {\n  const githubData = item.json.github_data;\n  const currentData = item.json.current_data;\n\n  if (!githubData || !currentData) {\n    item.json.hasChanges = true;\n    continue;\n  }\n\n  const githubStr = JSON.stringify(sortObject(deepClean(githubData)));\n  const currentStr = JSON.stringify(sortObject(deepClean(currentData)));\n\n  item.json.hasChanges = githubStr !== currentStr;\n}\n\nreturn $input.all();"
      },
