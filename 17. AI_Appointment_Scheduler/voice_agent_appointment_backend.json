    {
      "parameters": {
        "jsCode": "// 1. Setup Business Hours & Timezone\nconst timezone = 'Asia/Karachi';\nconst WORK_START_HOUR = 9;\nconst WORK_END_HOUR = 18;\nconst BUFFER_HOURS = 2; // Minimum 2 hours from now\n\n// 2. Get current time and earliest bookable time\nconst now = DateTime.now().setZone(timezone);\nconst earliestBookableTime = now.plus({ hours: BUFFER_HOURS });\n\n// 3. Get the requested date from Input_data node\nconst requestedDateTime = DateTime.fromISO($('Input_data').first().json.date_time, { zone: timezone });\n\n// 4. Extract busy slots from Google Calendar events\nconst inputData = items[0].json.data || [];\n\n// Parse all busy slots and convert to timezone\nconst busySlots = inputData\n  .map(slot => ({\n    start: DateTime.fromISO(slot.start, { zone: timezone }),\n    end: DateTime.fromISO(slot.end, { zone: timezone })\n  }))\n  .sort((a, b) => a.start - b.start);\n\n// 5. Generate next 7 working days (Mon-Fri only) starting from today\nconst workDays = [];\nlet checkDate = now.startOf('day');\n\nfor (let i = 0; i < 14 && workDays.length < 7; i++) {\n  const dayOfWeek = checkDate.weekday; // 1=Mon, 7=Sun\n  if (dayOfWeek >= 1 && dayOfWeek <= 5) { // Mon-Fri only\n    workDays.push(checkDate);\n  }\n  checkDate = checkDate.plus({ days: 1 });\n}\n\n// 6. Function to find available slots for a given day\nfunction getAvailableSlotsForDay(day) {\n  const dateOnly = day.toISODate();\n  let dayStart = DateTime.fromISO(`${dateOnly}T${String(WORK_START_HOUR).padStart(2, '0')}:00:00`, { zone: timezone });\n  const dayEnd = DateTime.fromISO(`${dateOnly}T${String(WORK_END_HOUR).padStart(2, '0')}:00:00`, { zone: timezone });\n  \n  // If this is today, start from earliestBookableTime (now + 2 hours)\n  if (dateOnly === now.toISODate()) {\n    // Round up to next hour for cleaner slots\n    const roundedEarliest = earliestBookableTime.minute > 0 \n      ? earliestBookableTime.startOf('hour').plus({ hours: 1 })\n      : earliestBookableTime.startOf('hour');\n    \n    if (roundedEarliest > dayStart) {\n      dayStart = roundedEarliest;\n    }\n  }\n  \n  // If day has already ended or start is after end, no slots available\n  if (dayStart >= dayEnd) {\n    return [];\n  }\n  \n  // Filter busy slots for this specific day\n  const dayBusySlots = busySlots\n    .filter(slot => slot.start.toISODate() === dateOnly)\n    .sort((a, b) => a.start - b.start);\n  \n  let availableSlots = [];\n  let currentTime = dayStart;\n  \n  if (dayBusySlots.length === 0) {\n    availableSlots.push({ start: dayStart, end: dayEnd });\n  } else {\n    dayBusySlots.forEach(busy => {\n      const effectiveBusyStart = busy.start < dayStart ? dayStart : busy.start;\n      const effectiveBusyEnd = busy.end;\n      \n      if (currentTime < effectiveBusyStart) {\n        availableSlots.push({ start: currentTime, end: effectiveBusyStart });\n      }\n      if (effectiveBusyEnd > currentTime) {\n        currentTime = effectiveBusyEnd;\n      }\n    });\n    \n    if (currentTime < dayEnd) {\n      availableSlots.push({ start: currentTime, end: dayEnd });\n    }\n  }\n  \n  return availableSlots;\n}\n\n// 7. Format time to readable string (e.g., \"9am\", \"5pm\")\nfunction formatTime(dt) {\n  return dt.toFormat('ha').toLowerCase();\n}\n\n// 8. Build availability summary - intuitive format\nconst availabilityParts = [];\n\nworkDays.forEach(day => {\n  const slots = getAvailableSlotsForDay(day);\n  if (slots.length > 0) {\n    const dayName = day.toFormat('ccc d MMM'); // e.g., \"Wed 7 Jan\"\n    const slotsText = slots.map(s => `${formatTime(s.start)}-${formatTime(s.end)}`).join(' and ');\n    availabilityParts.push(`${dayName}: ${slotsText}`);\n  }\n});\n\n// 9. Create final human-readable summary\nconst available_slots_summary = availabilityParts.join(' | ');\n\n// 10. Return result - clean single output\nreturn {\n  available_slots_summary: available_slots_summary\n};"
      },
      "type": "n8n-nodes-base.code",
