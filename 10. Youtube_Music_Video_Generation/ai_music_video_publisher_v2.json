    {
      "parameters": {
        "jsCode": "// Get the incoming JSON data\nconst data = $json.data?.response?.sunoData || [];\n\n// Extract all song audio URLs\nconst songUris = data.map(item => ({\n  title: item.title,\n  audioUrl: item.audioUrl,\n  sourceAudioUrl: item.sourceAudioUrl,\n  imageUrl: item.imageUrl,\n}));\n\n// Return as items for next node\nreturn songUris.map(uri => ({ json: uri }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
